# JWT_SECRET is required; the app refuses to start when it is blank, missing or too short.
# Generate with: openssl rand -base64 32 (or openssl rand -hex 64; at least 32 bytes).
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# Optional, comma-separated, case-insensitive: existing accounts with these e-mails are promoted
# to ADMIN at start-up, and a listed e-mail with no account yet registers as ADMIN - so register
# the account first, then list its e-mail and restart (see README > Making an admin).
ADMIN_EMAILS=
# Optional: the origin Stripe sends the customer back to after checkout
# (/checkout-success, /checkout-cancel), without a trailing slash. Defaults to http://localhost:8080
# in dev; keep it commented out unless you set a value (an empty value is not a default).
# WEBSITE_URL=http://localhost:8080

# Database (dev profile). Local change: the course connects to localhost:3306,
# which on this machine is a different MySQL service that must not be touched.
# The dev database is the store-mysql Docker container on 3307 (see README).
DB_URL=jdbc:mysql://localhost:3307/store_api?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=MyPassword!
