# Required. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional. Checkout returns an error until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# Optional. Comma-separated e-mails that get the ADMIN role.
ADMIN_EMAILS=

# Optional. Where Stripe sends the customer back after checkout (defaults to http://localhost:8080).
# WEBSITE_URL=http://localhost:8080
